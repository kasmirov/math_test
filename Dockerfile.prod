# syntax=docker/dockerfile:1

# Production image: HTTPS via nginx (reverse proxy) + gunicorn.
# Certificates are mounted into /etc/nginx/certs (paths are configured through
# TLS_CERT_FILE / TLS_KEY_FILE). Full page set (landing + footer).

# --- Build stage ---
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-prod.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements-prod.txt

# --- Runtime stage ---
FROM python:3.12-slim

WORKDIR /app

# nginx + envsubst (gettext) + utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    gettext-base \
    fonts-liberation \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

COPY --from=builder /install /usr/local

COPY . .

RUN mkdir -p /app/data /etc/nginx/certs /var/www/certbot

ENV DATABASE_PATH=/app/data/app.db \
    APP_PAGES_MODE=full \
    JWT_COOKIE_SECURE=1 \
    SERVER_NAME=_ \
    HTTP_PORT=80 \
    HTTPS_PORT=443 \
    TLS_CERT_FILE=/etc/nginx/certs/fullchain.pem \
    TLS_KEY_FILE=/etc/nginx/certs/privkey.pem \
    GUNICORN_BIND=127.0.0.1:8000 \
    GUNICORN_WORKERS=3

COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

VOLUME ["/app/data", "/etc/nginx/certs"]

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsSk "https://127.0.0.1:${HTTPS_PORT}/help" || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
